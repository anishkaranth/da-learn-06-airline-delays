{
 "datasets": [
  {
   "name": "kpi",
   "displayName": "Headline KPIs",
   "queryLines": [
    "SELECT flights, on_time_pct / 100 AS on_time_rate, cancelled_pct / 100 AS cancelled_rate FROM workspace.da_learn_06.a_kpi_headline"
   ]
  },
  {
   "name": "otp_by_month",
   "displayName": "On-time arrival % by month",
   "queryLines": [
    "SELECT month_label, on_time_pct FROM workspace.da_learn_06.a_monthly ORDER BY month"
   ]
  },
  {
   "name": "cancel_by_month",
   "displayName": "Cancellation rate by month (%)",
   "queryLines": [
    "SELECT month_label, cancelled_pct FROM workspace.da_learn_06.a_monthly ORDER BY month"
   ]
  },
  {
   "name": "airline_otp",
   "displayName": "On-time arrival % by airline",
   "queryLines": [
    "SELECT airline_name, on_time_pct FROM workspace.da_learn_06.a_airline ORDER BY on_time_pct DESC"
   ]
  },
  {
   "name": "delay_causes",
   "displayName": "Share of late-arrival minutes by cause",
   "queryLines": [
    "SELECT cause, share_pct FROM workspace.da_learn_06.a_delay_causes ORDER BY share_pct DESC"
   ]
  },
  {
   "name": "hourly_dep_delay",
   "displayName": "Avg departure delay by scheduled hour (min)",
   "queryLines": [
    "SELECT sched_dep_hour, avg_dep_delay_min FROM workspace.da_learn_06.a_hourly ORDER BY sched_dep_hour"
   ]
  },
  {
   "name": "busiest_airports_delay",
   "displayName": "Avg departure delay, 10 busiest origins (min)",
   "queryLines": [
    "SELECT origin_code, avg_dep_delay_min FROM (SELECT origin_code, avg_dep_delay_min, departures FROM workspace.da_learn_06.a_origin_airports ORDER BY departures DESC LIMIT 10) t ORDER BY avg_dep_delay_min DESC"
   ]
  }
 ],
 "pages": [
  {
   "name": "overview",
   "displayName": "Overview",
   "layout": [
    {
     "widget": {
      "name": "title",
      "multilineTextboxSpec": {
       "lines": [
        "## US airline delays and cancellations - 2015 (full data)"
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 6,
      "height": 1
     }
    },
    {
     "widget": {
      "name": "kpi_flights",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "kpi",
         "fields": [
          {
           "name": "flights",
           "expression": "`flights`"
          }
         ],
         "disaggregated": true
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "flights",
         "displayName": "Flights (2015)",
         "format": {
          "type": "number",
          "abbreviation": "compact",
          "decimalPlaces": {
           "type": "max",
           "places": 1
          }
         }
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Flights (2015)"
       }
