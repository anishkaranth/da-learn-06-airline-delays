-- Measures for the 2015 US airline delays star model (home table: fact_flights)
Flights = COUNTROWS ( fact_flights )
Completed Flights = CALCULATE ( [Flights], fact_flights[flight_status] = "Completed" )
Cancelled Flights = CALCULATE ( [Flights], fact_flights[is_cancelled] = 1 )
Diverted Flights = CALCULATE ( [Flights], fact_flights[is_diverted] = 1 )
Cancellation Rate % = DIVIDE ( [Cancelled Flights], [Flights] )
Diversion Rate % = DIVIDE ( [Diverted Flights], [Flights] )
On-time Flights = SUM ( fact_flights[is_on_time] )
Late Flights (15+) = SUM ( fact_flights[is_arr_delayed_15] )
On-time Rate % = DIVIDE ( [On-time Flights], [On-time Flights] + [Late Flights (15+)] )
Avg Arrival Delay (min) = CALCULATE ( AVERAGE ( fact_flights[arr_delay_min] ), fact_flights[flight_status] = "Completed" )
Avg Departure Delay (min) = CALCULATE ( AVERAGE ( fact_flights[dep_delay_min] ), fact_flights[is_cancelled] = 0 )
Avg Delay When Late (min) = CALCULATE ( AVERAGE ( fact_flights[arr_delay_min] ), fact_flights[is_arr_delayed_15] = 1 )
Avg Taxi Out (min) = AVERAGE ( fact_flights[taxi_out_min] )
Days in Context = DISTINCTCOUNT ( fact_flights[date_key] )
Flights per Day = DIVIDE ( [Flights], [Days in Context] )
Late Aircraft Min = SUM ( fact_flights[late_aircraft_delay_min] )
Carrier Delay Min = SUM ( fact_flights[carrier_delay_min] )
NAS Delay Min = SUM ( fact_flights[nas_delay_min] )
Weather Delay Min = SUM ( fact_flights[weather_delay_min] )
Security Delay Min = SUM ( fact_flights[security_delay_min] )
Total Cause Min = [Late Aircraft Min] + [Carrier Delay Min] + [NAS Delay Min] + [Weather Delay Min] + [Security Delay Min]
Late Aircraft Share % = DIVIDE ( [Late Aircraft Min], [Total Cause Min] )
Carrier Share % = DIVIDE ( [Carrier Delay Min], [Total Cause Min] )
NAS Share % = DIVIDE ( [NAS Delay Min], [Total Cause Min] )
Weather Share % = DIVIDE ( [Weather Delay Min], [Total Cause Min] )
Arrivals = CALCULATE ( [Flights], USERELATIONSHIP ( fact_flights[dest_code], dim_airport[airport_code] ) )
Known-airport Flights = CALCULATE ( [Flights], fact_flights[origin_code] <> "UNK" )
